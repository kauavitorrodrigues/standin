# API ENVIRONMENT VARIABLES
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=standin
POSTGRES_PORT=5436

DATABASE_URL="postgresql://postgres:postgres@localhost:5436/standin?schema=public"
# Connections the API may hold open to Postgres. Defaults to 20.
DATABASE_POOL_MAX=20
# Set to 1 to log the queries sent to Postgres per join and per second.
# Off by default.
DB_QUERY_COUNT=0

SERVER_PORT=3001
SERVER_URL="http://localhost:3001"
JWT_SECRET="change-me"
FRONTEND_URL="http://localhost:5173"

# valor padrão se omitido: "local"
STORAGE_DRIVER=local

# Used when STORAGE_DRIVER=s3 (any S3-compatible service: Cloudflare R2, AWS S3,
# Backblaze B2, MinIO). The API will not boot if one of them is empty.
# S3_ENDPOINT is the service root, WITHOUT the bucket name. S3_PUBLIC_URL is the
# public address of the bucket (a custom domain), without the object key. The
# bucket also needs a CORS rule for FRONTEND_URL (see docs/storage.md).
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# opcional: relay STUN/TURN proprio (docker compose --profile turn up -d coturn).
# Sem TURN_HOST e TURN_SECRET a API nao devolve servidores ICE e os peers so
# se conectam por caminho direto (suficiente em rede local).
# O coturn nao sobe com TURN_SECRET vazio, e o valor nunca aparece na linha de
# comando do container. TURN_SECRET deve ser o mesmo valor no coturn e na API. Gere com:
#   openssl rand -hex 32
TURN_HOST=""
TURN_SECRET=""
TURN_PORT=3478
TURN_TTL_SECONDS=3600

# optional: sign in with GitHub. It is on only when the three variables below
# are filled (a GitHub App of the instance, see docs/github-login.md).
# Without them the API answers 404 on /auth/github and the button does not show.
# GITHUB_CALLBACK_URL must be the same as the Callback URL registered in the App:
# <API_URL>/auth/github/callback (in dev: http://localhost:3001/auth/github/callback).
# After the sign in the API redirects to FRONTEND_URL.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL=""
# Reserved for the future GitHub integration (webhooks and installing the App).
# Nothing reads them yet:
# GITHUB_WEBHOOK_SECRET=""
# GITHUB_APP_SLUG=""
# GITHUB_APP_ID=""
# GITHUB_APP_PRIVATE_KEY=""

# WEB ENVIRONMENT VARIABLES
VITE_BASE_API_URL="http://localhost:3001"

# Media server (SFU), runs inside the API process.
# MEDIA_WORKERS=0 turns it off. One worker serves the whole process.
MEDIA_WORKERS=1
MEDIA_LISTEN_IP="0.0.0.0"
# One port, used over UDP and TCP. Open it in the firewall.
MEDIA_LISTEN_PORT=44444
# The public address of the machine, needed when it sits behind a NAT.
# On a laptop use 127.0.0.1.
MEDIA_ANNOUNCED_ADDRESS=""

# The domain Caddy serves and gets a certificate for (deployment only).
SITE_ADDRESS="localhost"

# Deployment only, optional: the commit shown in the settings of the app. Do not
# fill them here, a fixed value goes stale. deploy/up.sh sets both from git on
# every deploy. Without them the settings show only the version.
# APP_COMMIT=""
# APP_COMMIT_TIME=""

# The first admin and organization, created by `pnpm --filter api bootstrap`
# (docs/deployment.md). Safe to run again: once an admin exists nothing changes
# and no password is reset. The container runs it on start when ADMIN_EMAIL and
# ADMIN_PASSWORD are both set. Without ADMIN_PASSWORD the command generates one
# and prints it once. The password follows the sign up rules.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# ADMIN_NAME="Admin"
# ORGANIZATION_NAME="Standin"

# Tests only: a throwaway, migrated and empty database that the integration
# tests of the API may write to. They stay off while this is empty. It must not
# be the database in DATABASE_URL.
# INTEGRATION_DATABASE_URL=""

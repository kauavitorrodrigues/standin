# API ENVIRONMENT VARIABLES
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=standin
POSTGRES_PORT=5436

DATABASE_URL="postgresql://postgres:postgres@localhost:5436/standin?schema=public"

SERVER_PORT=3001
SERVER_URL="http://localhost:3001"
JWT_SECRET="change-me"
FRONTEND_URL="http://localhost:5173"

# valor padrão se omitido: "local"
STORAGE_DRIVER=local

# opcional: relay STUN/TURN proprio (docker compose --profile turn up -d coturn).
# Sem TURN_HOST e TURN_SECRET a API nao devolve servidores ICE e os peers so
# se conectam por caminho direto (suficiente em rede local).
# O coturn nao sobe com TURN_SECRET vazio, e o valor nunca aparece na linha de
# comando do container. TURN_SECRET deve ser o mesmo valor no coturn e na API. Gere com:
#   openssl rand -hex 32
TURN_HOST=""
TURN_SECRET=""
TURN_PORT=3478
TURN_TTL_SECONDS=3600

# optional: sign in with GitHub. It is on only when the three variables below
# are filled (a GitHub App of the instance, see docs/github-login.md).
# Without them the API answers 404 on /auth/github and the button does not show.
# GITHUB_CALLBACK_URL must be the same as the Callback URL registered in the App:
# <API_URL>/auth/github/callback (in dev: http://localhost:3001/auth/github/callback).
# After the sign in the API redirects to FRONTEND_URL.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL=""
# Reserved for the future GitHub integration (webhooks and installing the App).
# Nothing reads them yet:
# GITHUB_WEBHOOK_SECRET=""
# GITHUB_APP_SLUG=""
# GITHUB_APP_ID=""
# GITHUB_APP_PRIVATE_KEY=""

# WEB ENVIRONMENT VARIABLES
VITE_BASE_API_URL="http://localhost:3001"

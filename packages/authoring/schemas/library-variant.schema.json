{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
        },
        "color": {
            "type": "object",
            "properties": {
                "key": {
                    "type": "string",
                    "maxLength": 32,
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "hex": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                }
            },
            "required": [
                "key",
                "hex"
            ]
        },
        "rotation": {
            "type": "string",
            "enum": [
                "DEG_0",
                "DEG_90",
                "DEG_180",
                "DEG_270"
            ]
        },
        "footprint": {
            "type": "object",
            "properties": {
                "w": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                },
                "h": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                },
                "offsetX": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                },
                "mask": {
                    "anyOf": [
                        {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                                "minItems": 1,
                                "type": "array",
                                "items": {
                                    "type": "boolean"
                                }
                            }
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "solidMask": {
                    "anyOf": [
                        {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                                "minItems": 1,
                                "type": "array",
                                "items": {
                                    "type": "boolean"
                                }
                            }
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "w",
                "h"
            ]
        },
        "actionParams": {
            "type": "object",
            "propertyNames": {
                "type": "string"
            },
            "additionalProperties": {}
        }
    },
    "additionalProperties": false
}

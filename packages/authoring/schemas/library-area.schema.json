{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
        },
        "stamp": {
            "type": "object",
            "properties": {
                "version": {
                    "type": "number",
                    "const": 1
                },
                "width": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 16
                },
                "height": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 12
                },
                "palette": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "tilesetId": {
                                "type": "string",
                                "minLength": 1
                            },
                            "tileIndex": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                            }
                        },
                        "required": [
                            "tilesetId",
                            "tileIndex"
                        ]
                    }
                },
                "layers": {
                    "type": "object",
                    "propertyNames": {
                        "type": "string",
                        "enum": [
                            "ground",
                            "walls",
                            "furniture",
                            "foreground"
                        ]
                    },
                    "additionalProperties": {
                        "type": "array",
                        "items": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                        }
                    }
                },
                "objects": {
                    "maxItems": 150,
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "assetId": {
                                "type": "string",
                                "minLength": 1
                            },
                            "dx": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                            },
                            "dy": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                            },
                            "offsetX": {
                                "type": "integer",
                                "minimum": -31,
                                "maximum": 31
                            },
                            "offsetY": {
                                "type": "integer",
                                "minimum": -31,
                                "maximum": 31
                            },
                            "parentIndex": {
                                "anyOf": [
                                    {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 9007199254740991
                                    },
                                    {
                                        "type": "null"
                                    }
                                ]
                            }
                        },
                        "required": [
                            "assetId",
                            "dx",
                            "dy",
                            "offsetX",
                            "offsetY",
                            "parentIndex"
                        ]
                    }
                },
                "zone": {
                    "anyOf": [
                        {
                            "type": "object",
                            "properties": {
                                "label": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 60
                                },
                                "kind": {
                                    "type": "string",
                                    "enum": [
                                        "area",
                                        "private"
                                    ]
                                }
                            },
                            "required": [
                                "label"
                            ]
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "version",
                "width",
                "height",
                "palette",
                "layers",
                "objects",
                "zone"
            ]
        }
    },
    "required": [
        "name",
        "stamp"
    ]
}

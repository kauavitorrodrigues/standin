{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@standin/tsconfig/node-app.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "types": ["node", "express"],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
